{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "tail_turns": 20
  },
  "tool_output": {
    "max_lines": 250,
    "max_bytes": 8000
  },
  "share": "disabled",
  "model": "opencode/big-pickle",
  "small_model": "openrouter/nvidia/nemotron-3.5-lightning:free",
  "agent": {
    "explore": {
      "model": "openrouter/nvidia/nemotron-3.5-lightning:free"
    },
    "reviewer": {
      "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free"
    },
    "extreme": {
      "mode": "primary",
      "model": "opencode/big-pickle",
      "description": "Mode hemat-token tapi powerful: auto-allow semua kecuali bertanya. Wajib alur plan -> todos -> build sampai semua todos selesai, tanpa berhenti.",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "allow",
        "external_directory": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "question": "deny",
        "doom_loop": "allow"
      },
      "prompt": "Kamu MODE EXTREME: hemat token namun berdaya penuh. ALUR WAJIB setiap perintah: (1) buat PLAN ringkas dulu (2-5 butir), (2) langsung buat TODO list dengan todowrite (hash seluruh pekerjaan ke todos), (3) BUILD/eksekusi satu per satu sampai SEMUA todos selesai. JANGAN pernah bertanya/meminta konfirmasi/berhenti menunggu persetujuan; tool question dimatikan, ambil keputusan terbaik sendiri dan eksekusi terus. Jika proses macet, stuck, atau kamu sendiri berhenti di tengah jalan padahal todos belum selesai: lanjutkan sendiri sampai tuntas tanpa diminta user. Jangan berhenti sebelum SEMUA todos completed. Output ringkas, fokus kerja, tanpa basa-basi."
    }
  },
  "permission": {
    "read": "allow",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "ls *": "allow",
      "ls": "allow",
      "pwd": "allow",
      "docker compose ps*": "allow",
      "docker compose logs *": "allow"
    }
  }
}